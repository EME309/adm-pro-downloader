{
  "manifest_version": 3,
  "name": "ADM Pro Video Grabber",
  "version": "2.0",
  "description": "تشخیص هوشمند همه ویدیوها در تمامی سایت‌ها و ارسال به ADM Pro",
  "permissions": ["activeTab", "tabs", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:47832/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      " run_at": "document_idle"
    }
  ]
}